{
  "name": "nasa-analog-finder",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "backend": "python backend/server.py",
    "dev:full": "concurrently -k -n api,web -c blue,green \"npm:backend\" \"npm:dev\"",
    "build": "vite build",
    "preview": "vite preview",
    "serve": "python backend/server.py --static-dir frontend/dist",
    "start": "npm run build && npm run serve",
    "test": "python -m unittest discover -s backend -v"
  },
  "dependencies": {
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "vite": "^8.3.8"
  }
}
